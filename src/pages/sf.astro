      <div class="v1-banner-bg">
        <img src="/photos/sf_26/sf_01.webp" alt="JacHacks SF" />
        <div class="v1-banner-overlay"></div>
      </div>
      <div class="v1-banner-content">
        <div class="v1-banner-tag">LATEST EDITION</div>
        <div class="v1-banner-eyebrow">// JULY 26, 2026 · FOUNDERS, INC. · SAN FRANCISCO</div>
        <div class="v1-banner-title">JacHacks <span class="v1-banner-accent">SF</span></div>
        <div class="v1-banner-sub">Where the series landed in the Bay.</div>
        <div class="v1-stats-row">
          <div class="v1-stat">
            <span class="v1-stat-val">200+</span>
            <span class="v1-stat-key">BUILDERS</span>
          </div>
          <div class="v1-stat-sep">//</div>
          <div class="v1-stat">
            <span class="v1-stat-val">77</span>
