---
import '../styles/site.css';
---

<html lang="en">
  <head>
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t === 'light') document.documentElement.setAttribute('data-theme','light'); } catch(e){}
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/jaseci-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JacHacks A2Tech · Winners</title>
    <meta name="description" content="JacHacks A2Tech 2026: winners and projects from the two-day hackathon at the University of Michigan, Ann Arbor. Jaseci is the official hackathon partner of a2Tech360." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://jachacks.org/a2tech" />
    <meta property="og:title" content="JacHacks A2Tech · Winners" />
    <meta property="og:description" content="The winning projects from JacHacks A2Tech, the official hackathon of a2Tech360. September 26–27, 2026, Ann Arbor." />
    <meta property="og:image" content="https://jachacks.org/jaseci-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700;1,800&family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <!-- NAV -->
    <nav id="main-nav" class="scrolled">
      <div class="nav-inner">
        <a href="/" class="logo">
          <img src="/jaseci-logo.png" alt="JacHacks" class="logo-img" />
          <span class="logo-text">Jac<span class="logo-accent">Hacks</span></span>
        </a>
        <div class="nav-links">
          <a href="/" class="nav-link">// HOME</a>
          <a href="#winners" class="nav-link">// A2 TECH TREK</a>
          <a href="/sf" class="nav-link">// SF</a>
          <a href="/spring" class="nav-link">// SPRING</a>
          <a href="/winter" class="nav-link">// WINTER</a>
          <a href="/ohio" class="nav-link">// ROCKETHACKS</a>
          <a href="/gallery" class="nav-link">// GALLERY</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
          <svg class="tt-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="tt-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href="https://github.com/jaseci-labs/jaseci" target="_blank" rel="noopener noreferrer" class="nav-cta">STAR ON GITHUB</a>
        <button class="hamburger" id="hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href="/">// HOME</a>
      <a href="#winners">// A2 TECH TREK</a>
      <a href="/sf">// JACHACKS SF</a>
      <a href="/spring">// JACHACKS SPRING</a>
      <a href="/winter">// JACHACKS WINTER</a>
      <a href="/paradise">// VELRIC</a>
      <a href="/ohio">// ROCKETHACKS</a>
      <a href="/gallery">// GALLERY</a>
      <a href="https://github.com/jaseci-labs/jaseci" target="_blank" class="mobile-cta">STAR ON GITHUB</a>
    </div>

    <main class="edition-main">
    <!-- JACHACKS A2TECH BANNER -->
    <div class="v1-banner v1-banner-a2" id="a2tech">
      <div class="v1-banner-bg">
        <img src="/photos/a2tech_26/a2_01.webp" alt="JacHacks A2Tech" />
        <div class="v1-banner-overlay"></div>
      </div>
      <div class="v1-banner-content">
        <div class="v1-banner-tag">LATEST EDITION</div>
        <div class="v1-banner-eyebrow">// SEPTEMBER 26–27, 2026 · UNIVERSITY OF MICHIGAN · ANN ARBOR</div>
        <div class="v1-banner-title">JacHacks <span class="v1-banner-accent">A2Tech</span></div>
        <div class="v1-banner-sub">Where the series came home for a2Tech360.</div>
        <div class="v1-stats-row">
          <div class="v1-stat">
            <span class="v1-stat-val">27</span>
            <span class="v1-stat-key">PROJECTS</span>
          </div>
          <div class="v1-stat-sep">//</div>
          <div class="v1-stat">
            <span class="v1-stat-val">2</span>
            <span class="v1-stat-key">DAYS</span>
          </div>
          <div class="v1-stat-sep">//</div>
          <div class="v1-stat">
            <span class="v1-stat-val">9</span>
            <span class="v1-stat-key">WINNERS</span>
          </div>
        </div>
      </div>
    </div>

    <!-- JACHACKS A2TECH WINNERS -->
    <section class="section section-dark" id="winners">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-eyebrow">// JACHACKS A2TECH · WINNERS</div>
          <h2 class="section-title">The Best of <span class="text-accent">JacHacks A2Tech</span></h2>
          <p class="section-sub">The standout projects, built over two days at the University of Michigan during a2Tech360, September 2026.</p>
        </div>

        <!-- Agentic AI -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Agentic AI</span>
            <span class="track-label-sub">2 WINNERS</span>
          </div>
          <div class="projects-grid projects-grid-2">
            <div class="pcard reveal"
              data-video="XO8sphN2puw"
              data-devpost="https://devpost.com/software/trace-uefvb5">
              <div class="pcard-bar bar-1st"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_photos/005/411/695/datas/original.png" alt="Trace" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-1st">1ST PLACE</span></div>
                <h3 class="pcard-title">Trace</h3>
                <p class="pcard-team">Miguel Orti Vila, Anshu Pathak, Aidana Kuat, Gabriel Salvatore</p>
                <p class="pcard-desc">Keeps every report from a disaster in one Jac graph of sources, claims, people, and places, so responders can see where each claim came from while an agent traces relayed reports back to their source for human review.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/trace-uefvb5" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-1"
              data-video="XpCMND44t7U"
              data-devpost="https://devpost.com/software/claimsureai">
              <div class="pcard-bar bar-2nd"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_thumbnail_photos/005/397/469/datas/original.png" alt="ClaimSure AI" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-2nd">2ND PLACE</span></div>
                <h3 class="pcard-title">ClaimSure AI</h3>
                <p class="pcard-team">Abhayjit Singh Gulati, Shankhanil Borthakur, Sri Satya Vinay Venneti, Adithyan Raja</p>
                <p class="pcard-desc">Two Jac walkers share one graph: one flags health insurance claims likely to be denied before they are filed, the other reads a denial letter, finds the plan clause it contradicts, and drafts a cited appeal for a person to approve.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/claimsureai" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Dev Tooling & Open Track -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Dev Tooling &amp; Open Track</span>
            <span class="track-label-sub">1 WINNER</span>
          </div>
          <div class="projects-grid projects-grid-2">
            <div class="pcard reveal"
              data-video="tjX7nOJCNEc"
              data-devpost="https://devpost.com/software/blindspot-oxvght">
              <div class="pcard-bar bar-1st"></div>
              <div class="pcard-thumb">
                <img src="https://img.youtube.com/vi/tjX7nOJCNEc/maxresdefault.jpg" alt="BlindSpot" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges">
                  <span class="pbadge pbadge-1st">1ST PLACE</span>
                  <span class="pbadge pbadge-extra">BEST OF GOOGLE</span>
                </div>
                <h3 class="pcard-title">BlindSpot</h3>
                <p class="pcard-team">Sakeena Patel, Lena Abedali</p>
                <p class="pcard-desc">Reads a Python repo and its coverage report, builds a Jac call graph, and flags the untested functions that other code actually depends on, with a Gemini agent over MCP ranking what to test first.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/blindspot-oxvght" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Local Impact -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Local Impact</span>
            <span class="track-label-sub">3 WINNERS</span>
          </div>
          <div class="projects-grid projects-grid-3">
            <div class="pcard reveal"
              data-video="BVq1qQAO00Y"
              data-devpost="https://devpost.com/software/m-local">
              <div class="pcard-bar bar-1st"></div>
              <div class="pcard-thumb">
                <img src="https://img.youtube.com/vi/BVq1qQAO00Y/maxresdefault.jpg" alt="M-Local" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-1st">GRAND PRIZE</span></div>
                <h3 class="pcard-title">M-Local</h3>
                <p class="pcard-team">Rohan Maxa, Travis Jones, Manthan Patil, Adam Jiang</p>
                <p class="pcard-desc">A UMich-first platform where local businesses publish offers and students discover, save, and claim them, with QR redemption so businesses can see it working.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/m-local" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-1"
              data-video="m1bnm30PDJc"
              data-devpost="https://devpost.com/software/road-to-research">
              <div class="pcard-bar bar-2nd"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_thumbnail_photos/005/411/573/datas/original.png" alt="Road to Research" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-2nd">COMMUNITY FAVORITE</span></div>
                <h3 class="pcard-title">Road to Research</h3>
                <p class="pcard-team">Melody Bai, Lucero Toral</p>
                <p class="pcard-desc">Helps students find professors by department, research area, and name, with recent papers and subfields from OpenAlex, grants, and any public note that a lab is hiring.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/road-to-research" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-2"
              data-video="_-DyEIsIK2Y"
              data-devpost="https://devpost.com/software/adoptable-pet-match">
              <div class="pcard-bar bar-2nd"></div>
              <div class="pcard-thumb">
                <img src="https://img.youtube.com/vi/_-DyEIsIK2Y/maxresdefault.jpg" alt="Adoptable Pet Match" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-2nd">COMMUNITY FAVORITE</span></div>
                <h3 class="pcard-title">Adoptable Pet Match</h3>
                <p class="pcard-team">Elizabeth C.</p>
                <p class="pcard-desc">Adopters fill out a quick lifestyle profile and AI matches them with the Humane Society of Huron Valley pets that fit them best, built solo on JacHammer as a first hackathon project.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/adoptable-pet-match" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Jac Awards -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Jac Awards</span>
            <span class="track-label-sub">3 AWARDS</span>
          </div>
          <div class="projects-grid projects-grid-3">
            <div class="pcard reveal"
              data-video="NQmjHy6u9wI"
              data-devpost="https://devpost.com/software/countersign-mcp">
              <div class="pcard-bar bar-award"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_thumbnail_photos/005/402/412/datas/original.png" alt="CounterSign MCP" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges">
                  <span class="pbadge pbadge-award">BEST JACLANG</span>
                  <span class="pbadge pbadge-extra">BEST OF IBM</span>
                </div>
                <h3 class="pcard-title">CounterSign MCP</h3>
                <p class="pcard-team">Arnav D, Pradhum Niroula, Sidhant Singh, Arihan Iyer</p>
                <p class="pcard-desc">Sits between an AI agent and the payment provider, vetting the whole spending plan and then every purchase with budget rules and an LLM judge before a single dollar moves.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/countersign-mcp" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-1"
              data-video="7P4iVZSROqE"
              data-devpost="https://devpost.com/software/red-queen-pm2iat">
              <div class="pcard-bar bar-award"></div>
              <div class="pcard-thumb">
                <img src="https://img.youtube.com/vi/7P4iVZSROqE/maxresdefault.jpg" alt="Red Queen" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-award">BEST JACHAMMER</span></div>
                <h3 class="pcard-title">Red Queen</h3>
                <p class="pcard-team">Yorg Kattukaran, Isaac Poothullil, Pranav Nandyalam, Jayden Huang</p>
                <p class="pcard-desc">An AI red team and blue team for your code: one agent finds real exploits, another patches them, and a referee re-fires every attack and reruns the app's health checks to prove each fix works.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/red-queen-pm2iat" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-2"
              data-video="gdSyk6NS1Uk"
              data-devpost="https://devpost.com/software/cirql">
              <div class="pcard-bar bar-award"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_thumbnail_photos/005/411/618/datas/original.png" alt="Cirql" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-award">BEST MOBILE THROUGH JAC</span></div>
                <h3 class="pcard-title">Cirql</h3>
                <p class="pcard-team">Sohum Kapoor, Jesse Chang</p>
                <p class="pcard-desc">A personal CRM where agents walk your relationship graph: a 30 second voice memo becomes people and promises, and friends' agents find warm intros without exposing names.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/cirql" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- GALLERY TEASER -->
    <section class="section" id="gallery">
      <div class="container">
        <div class="gallery-teaser reveal">
          <div class="gallery-teaser-photos">
            <div class="gt-photo gt-p1"><img src="/photos/a2tech_26/a2_01.webp" alt="" loading="lazy" /></div>
            <div class="gt-photo gt-p2"><img src="/photos/a2tech_26/a2_02.webp" alt="" loading="lazy" /></div>
            <div class="gt-photo gt-p3"><img src="/photos/a2tech_26/a2_08.webp" alt="" loading="lazy" /></div>
            <div class="gt-photo gt-p4"><img src="/photos/a2tech_26/a2_06.webp" alt="" loading="lazy" /></div>
            <div class="gt-overlay"></div>
          </div>
          <div class="gallery-teaser-content">
            <div class="section-eyebrow">// JACHACKS A2TECH · GALLERY</div>
            <h2 class="section-title">Moments from <span class="text-accent">the Weekend</span></h2>
            <p class="section-sub">Two days. 27 projects. University of Michigan, Ann Arbor.</p>
            <a href="/gallery#a2tech" class="btn-primary" style="margin-top:2rem; display:inline-flex;">
              VIEW FULL GALLERY
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- VIDEO MODAL -->
    <div class="vm-backdrop" id="vm-backdrop"></div>
    <div class="vm" id="vm">
      <div class="vm-shell">
        <span class="vm-caption">// PROJECT DEMO</span>
        <button class="vm-close" id="vm-close" aria-label="Close video">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <div class="vm-body">
          <iframe id="vm-iframe" src="" title="Project demo video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>

    </main>

