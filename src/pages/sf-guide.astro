---
import '../styles/site.css';
import '../styles/hacker-guide.css';
---

<html lang="en">
  <head>
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t === 'light') document.documentElement.setAttribute('data-theme','light'); } catch(e){}
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/jaseci-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JacHacks SF · Hacker Guide</title>
    <meta name="description" content="The JacHacks SF hacker guide: schedule, location, prizes, tracks, rules, submissions, and everything you need for July 26, 2026 at Founders, Inc., San Francisco." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://jachacks.org/sf-guide" />
    <meta property="og:title" content="JacHacks SF · Hacker Guide" />
    <meta property="og:description" content="Everything you need for JacHacks SF in one place: schedule, prizes, rules, and submissions. July 26, 2026, Founders, Inc., San Francisco." />
    <meta property="og:image" content="https://jachacks.org/jaseci-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700;1,800&family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <!-- NAV -->
    <nav id="main-nav">
      <div class="nav-inner">
        <a href="/" class="logo">
          <img src="/jaseci-logo.png" alt="JacHacks" class="logo-img" />
          <span class="logo-text">Jac<span class="logo-accent">Hacks</span></span>
        </a>
        <div class="nav-links">
          <a href="/" class="nav-link">// HOME</a>
          <a href="#schedule" class="nav-link">// SCHEDULE</a>
          <a href="#prizes" class="nav-link">// PRIZES</a>
          <a href="#submissions" class="nav-link">// SUBMIT</a>
          <a href="#resources" class="nav-link">// RESOURCES</a>
          <a href="#rules" class="nav-link">// RULES</a>
          <a href="#judges" class="nav-link">// JUDGES</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
          <svg class="tt-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="tt-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href="https://luma.com/9x1573sw" target="_blank" rel="noopener noreferrer" class="nav-cta">REGISTER NOW</a>
        <button class="hamburger" id="hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href="/">// HOME</a>
      <a href="#schedule">// SCHEDULE</a>
      <a href="#prizes">// PRIZES</a>
      <a href="#submissions">// SUBMIT</a>
      <a href="#resources">// RESOURCES</a>
      <a href="#rules">// RULES</a>
      <a href="#judges">// JUDGES</a>
      <a href="https://luma.com/9x1573sw" target="_blank" class="mobile-cta">REGISTER NOW</a>
    </div>

    <!-- GUIDE HERO -->
    <section class="sfg-hero">
      <div class="hero-grid-bg"></div>
      <div class="hero-spotlight"></div>
      <div class="sfg-hero-content">
        <div class="hero-series-badge reveal">
          <span class="series-dot"></span>
          <span>JACHACKS SF 2026</span>
          <span class="series-sep">·</span>
          <span class="series-event">HACKER GUIDE</span>
        </div>
        <h1 class="title-main reveal">Hacker <span class="title-spring">Guide.</span></h1>
        <p class="hero-sub reveal">Everything you need for the day in one place. A one-day AI hackathon hosted by Jaseci Labs with $9K in prizes.</p>
        <div class="hero-meta-line reveal">
          <span>SUN, JULY 26</span>
          <span class="meta-dot">·</span>
          <span>8:00 AM – 10:00 PM</span>
          <span class="meta-dot">·</span>
          <span>FOUNDERS, INC. · FORT MASON</span>
        </div>
        <div class="cta-group reveal">
          <a href="#schedule" class="btn-primary">
            VIEW SCHEDULE
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
          <a href="https://discord.gg/uGGKmKEFd" target="_blank" rel="noopener noreferrer" class="btn-accent">
            JOIN DISCORD
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
          <a href="https://jachacks-sf.devpost.com/" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            DEVPOST
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- QUICK INFO CARDS -->
    <section class="section sfg-section-tight">
      <div class="container">
        <div class="sfg-info-grid reveal">
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="sfg-info-label">LOCATION</div>
            <div class="sfg-info-title">Founders, Inc.</div>
            <p class="sfg-info-desc">Fort Mason Center, 2 Marina Blvd, Building B300, San Francisco, CA 94123. A 42,000 sq ft startup campus right on the Bay.</p>
          </div>
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <div class="sfg-info-label">DISCORD</div>
            <div class="sfg-info-title">Main comms channel</div>
            <p class="sfg-info-desc">Announcements, schedule updates, mentor requests, and team matching. Post questions in <b>#ask-an-organizer</b>. <a class="sfg-link" href="https://discord.gg/uGGKmKEFd" target="_blank" rel="noopener noreferrer">Join before the event →</a></p>
          </div>
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
            </div>
            <div class="sfg-info-label">PRIZES</div>
            <div class="sfg-info-title">$9K in prizes</div>
            <p class="sfg-info-desc">Agentic AI (up to $2K), Fintech / Open, Social Impact, plus Best JacHammer, Best Use of Jac, and AI for Defense special awards. <a class="sfg-link" href="#prizes">See all prizes &amp; tracks →</a></p>
          </div>
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
            </div>
            <div class="sfg-info-label">FOOD</div>
            <div class="sfg-info-title">You're covered</div>
            <p class="sfg-info-desc">Breakfast, lunch, dinner, and snacks all day. Dietary restrictions? Flag them on your Luma registration or ping us on Discord.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section class="section" id="schedule">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-eyebrow">// THE SCHEDULE</div>
          <h2 class="section-title">One Day. <span class="text-accent">Zero Wasted Minutes.</span></h2>
          <p class="section-sub">Here's exactly how the day runs. Any day-of updates will be posted on Discord.</p>
        </div>

        <div class="sfg-timeline reveal">
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">8:00 – 10:00 AM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Check-In, Breakfast + Networking</div>
              <div class="sfg-tl-desc">Grab your badge, eat, meet other builders, and start forming teams</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">10:00 – 10:30 AM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Opening + Keynote</div>
              <div class="sfg-tl-desc">JacHacks welcome, followed by a keynote from Prof. Jason Mars</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">10:30 – 10:45 AM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Hackathon Briefing</div>
              <div class="sfg-tl-desc">Rules, tracks, prizes, sponsor resources, judging criteria, and how to submit</div>
            </div>
          </div>
          <div class="sfg-tl-item sfg-tl-milestone sfg-tl-green">
            <div class="sfg-tl-time">10:45 AM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">⭐ Hacking Begins</div>
              <div class="sfg-tl-desc">Clocks start. Build.</div>
            </div>
          </div>
          <div class="sfg-tl-item sfg-tl-featured">
            <div class="sfg-tl-time">11:00 AM – 12:00 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Jac Workshop <span class="sfg-tl-tag">DON'T SKIP THIS</span></div>
              <div class="sfg-tl-desc">One hour, zero to shipping on Jac. All levels welcome.</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">11:00 AM – 1:00 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">First Build Block</div>
              <div class="sfg-tl-desc">Finalize teams, lock in ideas, start building</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">1:00 – 2:15 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Lunch + Networking</div>
              <div class="sfg-tl-desc">Lunch is served! Keep planning while you eat</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">2:15 – 3:30 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Second Build Block</div>
              <div class="sfg-tl-desc">Mentor office hours and sponsor support continue</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">3:30 – 4:30 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Career AMA with Jeff Nguyen, Conrad Scheibye &amp; Aaryan Khanna</div>
              <div class="sfg-tl-desc">Jeff Nguyen is the Founder of BobaTalks and a University Recruiter at Tesla. Resume feedback, internship recruiting advice, and open Q&A. Teams can keep hacking if they prefer.</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">4:30 – 5:30 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">YC Application Workshop</div>
              <div class="sfg-tl-desc">With Mehul from Koyal AI (YC F25) and Vatsal (Ex-YC): how to actually apply to YC</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">4:30 – 6:00 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Third Build Block</div>
              <div class="sfg-tl-desc">Focused building, testing, and mentor support</div>
            </div>
          </div>
          <div class="sfg-tl-item sfg-tl-milestone sfg-tl-orange">
            <div class="sfg-tl-time">5:50 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">⭐ Partial Submission Checkpoint</div>
              <div class="sfg-tl-desc">Submit your draft on Devpost to be considered for judging. You can keep editing after, this just helps us organize judging.</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">6:00 – 6:45 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Dinner</div>
              <div class="sfg-tl-desc">Dinner runs alongside hacking so you don't lose a build hour</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">6:45 – 7:15 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Final Build + Submission Period</div>
              <div class="sfg-tl-desc">Finish your demo, submit, and prep your pitch</div>
            </div>
          </div>
          <div class="sfg-tl-item sfg-tl-milestone sfg-tl-red">
            <div class="sfg-tl-time">7:15 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">🛑 Submissions Close <span class="sfg-tl-tag sfg-tag-red">HARD DEADLINE</span></div>
              <div class="sfg-tl-desc">To keep the event running smoothly, late submissions are not accepted</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">7:15 – 7:30 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Judging Setup</div>
              <div class="sfg-tl-desc">Teams move to assigned demo areas</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">7:30 – 8:15 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Project Demos + Judging</div>
              <div class="sfg-tl-desc">4-minute demos, judged in parallel groups</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">8:15 – 8:45 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Judges Deliberate</div>
              <div class="sfg-tl-desc">Network while scores are finalized</div>
            </div>
          </div>
          <div class="sfg-tl-item">
            <div class="sfg-tl-time">8:45 – 9:15 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Second Round Demos</div>
              <div class="sfg-tl-desc">Top teams demo again</div>
            </div>
          </div>
          <div class="sfg-tl-item sfg-tl-milestone sfg-tl-cyan">
            <div class="sfg-tl-time">9:30 PM</div>
            <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
            <div class="sfg-tl-body">
              <div class="sfg-tl-name">Closing Ceremony</div>
              <div class="sfg-tl-desc">Winner announcements, prizes, sponsor and judge recognition, group photos, and final networking</div>
            </div>
          </div>
        </div>

        <!-- DEADLINE CALLOUT -->
        <div class="sfg-deadlines reveal">
          <div class="sfg-deadline-card sfg-dl-orange">
            <div class="sfg-dl-time">5:50 PM</div>
            <div class="sfg-dl-label">PARTIAL SUBMISSION CHECKPOINT</div>
            <p>Make your first partial submission on Devpost to be considered for judging. You can still edit after.</p>
          </div>
          <div class="sfg-deadline-card sfg-dl-red">
            <div class="sfg-dl-time">7:15 PM</div>
            <div class="sfg-dl-label">FINAL SUBMISSIONS · HARD DEADLINE</div>
            <p>No late submissions will be accepted. Submit early, edit often.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PRIZES & TRACKS -->
    <section class="section" id="prizes">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-eyebrow">// PRIZES & TRACKS</div>
          <h2 class="section-title">$9K on the <span class="text-accent">Table.</span></h2>
          <p class="section-sub">Pick <b>one main track</b> when you submit on Devpost, then select any special awards your project also fits. Special awards are judged separately, so you can win both.</p>
        </div>

        <div class="sfg-prize-tier reveal">MAIN TRACKS <span class="sfg-tier-hint">· pick one</span></div>
        <div class="sfg-prize-grid sfg-prize-grid-3 reveal">
          <div class="sfg-prize-card sfg-prize-featured">
            <div class="sfg-prize-track">AGENTIC AI</div>
            <div class="sfg-prize-rows">
              <div class="sfg-prize-row"><span class="sfg-prize-place">1ST PLACE</span><span class="sfg-prize-amt">$2,000</span></div>
              <div class="sfg-prize-row"><span class="sfg-prize-place">2ND PLACE</span><span class="sfg-prize-amt sfg-amt-dim">$1,000</span></div>
            </div>
            <p class="sfg-prize-note">Best agentic AI project built at JacHacks SF</p>
          </div>
          <div class="sfg-prize-card">
            <div class="sfg-prize-track">FINTECH / OPEN</div>
            <div class="sfg-prize-rows">
              <div class="sfg-prize-row"><span class="sfg-prize-place">1ST PLACE</span><span class="sfg-prize-amt">$1,500</span></div>
              <div class="sfg-prize-row"><span class="sfg-prize-place">2ND PLACE</span><span class="sfg-prize-amt sfg-amt-dim">$800</span></div>
            </div>
            <p class="sfg-prize-note">Best fintech project, or best project overall in the open track</p>
          </div>
          <div class="sfg-prize-card">
            <div class="sfg-prize-track">SOCIAL IMPACT</div>
            <div class="sfg-prize-rows">
              <div class="sfg-prize-row"><span class="sfg-prize-place">1ST PLACE</span><span class="sfg-prize-amt">$1,500</span></div>
              <div class="sfg-prize-row"><span class="sfg-prize-place">2ND PLACE</span><span class="sfg-prize-amt sfg-amt-dim">$800</span></div>
            </div>
            <p class="sfg-prize-note">Innovation with the most significant societal impact</p>
          </div>
        </div>

        <div class="sfg-prize-tier reveal">SPECIAL AWARDS <span class="sfg-tier-hint">· select separately</span></div>
        <div class="sfg-prize-grid sfg-prize-grid-3 reveal">
          <div class="sfg-prize-card sfg-prize-special">
            <div class="sfg-prize-track">BEST JACHAMMER</div>
            <div class="sfg-prize-rows">
              <div class="sfg-prize-row"><span class="sfg-prize-place">SPECIAL AWARD</span><span class="sfg-prize-amt">$400</span></div>
            </div>
            <p class="sfg-prize-note">Use <a class="sfg-link" href="https://jachammer.ai" target="_blank" rel="noopener noreferrer">jachammer.ai</a> to build and ship a working application.</p>
          </div>
          <div class="sfg-prize-card sfg-prize-special">
            <div class="sfg-prize-track">BEST USE OF JAC</div>
            <div class="sfg-prize-rows">
              <div class="sfg-prize-row"><span class="sfg-prize-place">SPECIAL AWARD</span><span class="sfg-prize-amt">$400</span></div>
            </div>
            <p class="sfg-prize-note">The team that hammers hardest on Jac, the most impressive use of the language</p>
          </div>
          <div class="sfg-prize-card sfg-prize-special">
            <div class="sfg-prize-track">AI FOR DEFENSE</div>
            <div class="sfg-prize-rows">
              <div class="sfg-prize-row"><span class="sfg-prize-place">SPECIAL AWARD</span><span class="sfg-prize-amt">$500</span></div>
