    <style is:global>
      /* ── A2TECH GUIDE ADDITIONS ── */
      .a2g-hero { padding-bottom:5rem; }
      .a2g-hero-lines { position:absolute; right:-4%; bottom:-6%; width:min(980px,68vw); opacity:.2; pointer-events:none; z-index:1; -webkit-mask-image:radial-gradient(120% 120% at 100% 100%, #000 30%, transparent 78%); mask-image:radial-gradient(120% 120% at 100% 100%, #000 30%, transparent 78%); }
      .a2g-lockup { display:flex; flex-direction:column; align-items:center; gap:.65rem; margin-bottom:1.4rem; }
      .a2g-lockup-label { font-family:var(--mono); font-size:.58rem; letter-spacing:.28em; color:rgba(242,234,214,.4); }
      .a2g-lockup-link { display:block; line-height:0; transition:transform .3s ease; }
      .a2g-lockup-link:hover { transform:translateY(-2px); }
      .a2g-lockup-logo { height:2.5rem; width:auto; object-fit:contain; opacity:.9; }
      .a2g-logo-light { display:none; }
      :root[data-theme="light"] .a2g-logo-dark { display:none; }
      :root[data-theme="light"] .a2g-logo-light { display:block; }
      :root[data-theme="light"] .a2g-lockup-label { color:rgba(26,24,40,.5); }
      :root[data-theme="light"] .a2g-hero-lines { opacity:.28; }

      /* two-day schedule */
      .a2g-days { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:start; }
      .a2g-days .sfg-timeline { max-width:none; }
      .a2g-days .sfg-tl-item { grid-template-columns:128px 30px 1fr; }
      .a2g-day { display:flex; align-items:center; gap:.7rem; margin-bottom:.6rem; }
      .a2g-day-num { font-family:var(--mono); font-weight:600; font-size:.62rem; letter-spacing:.2em; color:#000; background:var(--primary); border-radius:6px; padding:.3rem .6rem; box-shadow:0 0 16px rgba(249,115,22,.4); }
      .a2g-day-date { font-family:var(--mono); font-size:.66rem; letter-spacing:.22em; color:var(--text); }
      .a2g-day-rule { flex:1; height:1px; background:linear-gradient(90deg, rgba(249,115,22,.35), transparent); }
      .a2g-deadlines { grid-template-columns:1fr; max-width:none; margin-top:1.8rem; }
      .sfg-tl-purple .sfg-tl-body { background:rgba(168,85,247,.07); border:1px solid rgba(168,85,247,.3); }
      .sfg-tl-purple .sfg-tl-dot { border-color:#a855f7; box-shadow:0 0 10px rgba(168,85,247,.55); }
      .sfg-tl-purple .sfg-tl-name { color:#c79bff; }
      :root[data-theme="light"] .sfg-tl-purple .sfg-tl-name { color:#7e22ce; }
      :root[data-theme="light"] .a2g-day-date { color:#3d3c45; }

      /* tracks & awards */
      .a2g-prize-local { color:inherit; }
      .a2g-award-tag { align-self:flex-start; font-family:var(--mono); font-size:.58rem; letter-spacing:.16em; color:var(--light); background:rgba(255,255,255,.04); border:1px solid var(--border); border-radius:100px; padding:.25rem .65rem; margin:-.35rem 0 1rem; }
      .a2g-prize-sponsor { border-color:rgba(168,85,247,.35); background:linear-gradient(160deg, rgba(168,85,247,.07), var(--card) 55%); }
      .a2g-prize-sponsor .sfg-prize-track { color:#c79bff; font-size:.82rem; }
      .a2g-prize-sponsor .a2g-award-tag { margin-bottom:0; }
      :root[data-theme="light"] .a2g-award-tag { background:rgba(0,0,0,.03); border-color:rgba(0,0,0,.09); }
      :root[data-theme="light"] .a2g-prize-sponsor { background:linear-gradient(160deg, rgba(168,85,247,.06), #fff 55%); }
      :root[data-theme="light"] .a2g-prize-sponsor .sfg-prize-track { color:#7e22ce; }

      /* local impact */
      .a2g-li { display:grid; grid-template-columns:1.05fr 1fr; gap:1rem; align-items:stretch; }
      .a2g-li-prompt { display:flex; flex-direction:column; gap:1rem; border:1px solid rgba(249,115,22,.5); border-radius:18px; padding:2.2rem 2rem; background:linear-gradient(155deg, rgba(249,115,22,.12), var(--card) 58%); box-shadow:0 0 36px rgba(249,115,22,.08); }
      .a2g-li-tag { font-family:var(--mono); font-weight:600; font-size:.62rem; letter-spacing:.22em; color:var(--pl); }
      .a2g-li-quote { font-family:var(--serif); font-weight:800; font-size:clamp(1.5rem,3vw,2.15rem); line-height:1.2; letter-spacing:-.01em; color:#fff; }
      .a2g-li-quote em { font-style:italic; font-weight:700; color:var(--primary); }
      .a2g-li-body { font-size:.92rem; line-height:1.7; color:var(--light); }
      .a2g-li-body b { color:var(--text); }
      .a2g-li-rule { margin-top:auto; display:flex; gap:1rem; align-items:flex-start; border-top:1px solid rgba(255,255,255,.07); padding-top:1.1rem; }
      .a2g-li-rule-tag { font-family:var(--mono); font-size:.6rem; font-weight:600; letter-spacing:.14em; color:#000; background:var(--primary); border-radius:6px; padding:.3rem .55rem; flex-shrink:0; }
      .a2g-li-rule p { font-size:.9rem; line-height:1.6; color:var(--text); }
      .a2g-li-side { display:flex; flex-direction:column; gap:.8rem; }
      .a2g-li-dirs-label { font-family:var(--mono); font-size:.62rem; letter-spacing:.22em; color:var(--light); text-transform:uppercase; }
      .a2g-li-dirs { display:grid; grid-template-columns:1fr 1fr; gap:.8rem; flex:1; }
      .a2g-li-dir { display:flex; flex-direction:column; gap:.35rem; background:var(--card); border:1px solid var(--border); border-radius:14px; padding:1.15rem 1.2rem; transition:border-color .25s, transform .25s, box-shadow .25s; }
      .a2g-li-dir:hover { border-color:rgba(249,115,22,.45); transform:translateY(-3px); box-shadow:0 12px 32px rgba(0,0,0,.35), 0 0 24px rgba(249,115,22,.08); }
      .a2g-li-dir-icon { font-size:1.25rem; line-height:1; margin-bottom:.2rem; }
      .a2g-li-dir b { font-family:var(--display); font-weight:700; font-size:1.05rem; color:#fff; }
      .a2g-li-dir p { font-size:.8rem; line-height:1.55; color:var(--light); }
      .a2g-li-foot { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:1rem; }
      .a2g-li-card { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:1.6rem 1.6rem; }
      .a2g-li-card p { font-size:.88rem; line-height:1.65; color:var(--light); }
      .a2g-li-card p b { color:var(--text); }
      .a2g-li-card-hot { border-color:rgba(249,115,22,.45); background:linear-gradient(160deg, rgba(249,115,22,.08), var(--card) 60%); }
      .a2g-li-note { margin-top:.7rem; font-size:.82rem !important; }
      .a2g-li-close { text-align:center; margin-top:2rem; font-family:var(--display); font-size:1.15rem; letter-spacing:.01em; color:var(--light); }
      .a2g-li-close b { color:var(--primary); }
      :root[data-theme="light"] .a2g-li-prompt { background:linear-gradient(155deg, rgba(249,115,22,.08), #fff 58%); }
      :root[data-theme="light"] .a2g-li-quote,
      :root[data-theme="light"] .a2g-li-dir b { color:#1a1828; }
      :root[data-theme="light"] .a2g-li-rule p { color:#3d3c45; }
      :root[data-theme="light"] .a2g-li-rule { border-top-color:rgba(0,0,0,.08); }
      :root[data-theme="light"] .a2g-li-dir,
      :root[data-theme="light"] .a2g-li-card { background:#fff; border-color:rgba(0,0,0,.09); }
      :root[data-theme="light"] .a2g-li-card-hot { background:linear-gradient(160deg, rgba(249,115,22,.07), #fff 60%); }

      /* api credits */
      .a2g-credits { display:flex; gap:1.1rem; align-items:center; flex-wrap:wrap; background:var(--card); border:1px dashed rgba(0,212,255,.35); border-radius:14px; padding:1.1rem 1.4rem; }
      .a2g-credits-tag { font-family:var(--mono); font-weight:600; font-size:.62rem; letter-spacing:.2em; color:var(--cyan); flex-shrink:0; }
      .a2g-credits p { font-size:.86rem; line-height:1.6; color:var(--light); flex:1; min-width:240px; }
      :root[data-theme="light"] .a2g-credits { background:#fff; }
      :root[data-theme="light"] .a2g-credits-tag { color:#0e7490; }

      /* sponsors */
      .a2g-sponsors { display:grid; grid-template-columns:repeat(5,1fr); gap:.85rem; }
      .a2g-sponsor { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.75rem; background:var(--card); border:1px solid var(--border); border-radius:14px; padding:1.4rem 1rem 1.1rem; transition:border-color .25s, transform .25s, box-shadow .25s; }
      .a2g-sponsor:hover { border-color:rgba(249,115,22,.45); transform:translateY(-3px); box-shadow:0 12px 32px rgba(0,0,0,.35), 0 0 24px rgba(249,115,22,.08); }
      .a2g-sponsor img { height:40px; max-width:150px; width:auto; object-fit:contain; }
      .a2g-sponsor img.a2g-mark { height:36px; }
      .a2g-sponsor img.a2g-tile { height:48px; border-radius:8px; }
      .a2g-sponsor span { font-family:var(--mono); font-size:.58rem; letter-spacing:.14em; color:var(--light); text-transform:uppercase; text-align:center; }
      .a2g-invert { filter:invert(1) brightness(1.3); }
      :root[data-theme="light"] .a2g-sponsor { background:#fff; border-color:rgba(0,0,0,.09); }
      :root[data-theme="light"] .a2g-invert { filter:none; }

      .a2g-about { max-width:62ch; margin:2rem auto 0; font-size:.86rem; line-height:1.7; color:var(--light); }
      .a2g-about b { color:var(--text); }

      @media (max-width:1000px) {
        .a2g-days, .a2g-li { grid-template-columns:1fr; }
        .a2g-sponsors { grid-template-columns:repeat(3,1fr); }
      }
      @media (max-width:768px) {
        .a2g-days .sfg-tl-item { grid-template-columns:auto 1fr; }
        .a2g-li-foot, .a2g-li-dirs { grid-template-columns:1fr; }
        .a2g-li-prompt { padding:1.6rem 1.3rem; }
        .a2g-sponsors { grid-template-columns:1fr 1fr; }
        .a2g-lockup-logo { height:2rem; }
      }
    </style>

    <script>
      // ===== REVEAL =====
      const obs = new IntersectionObserver(es => { es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } }); }, { threshold:.08, rootMargin:'0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

      // ===== NAV =====
      const nav = document.getElementById('main-nav')!;
      window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));

      // ===== HAMBURGER =====
      const hbg = document.getElementById('hamburger')!, mm = document.getElementById('mobile-menu')!;
      hbg.addEventListener('click', () => { hbg.classList.toggle('open'); mm.classList.toggle('open'); });
      mm.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { hbg.classList.remove('open'); mm.classList.remove('open'); }));

      // ===== THEME TOGGLE =====
      const themeBtn = document.getElementById('theme-toggle')!;
      themeBtn.addEventListener('click', () => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          try { localStorage.setItem('theme','dark'); } catch(e){}
        } else {
          document.documentElement.setAttribute('data-theme','light');
          try { localStorage.setItem('theme','light'); } catch(e){}
        }
      });
    </script>
  </body>
</html>
