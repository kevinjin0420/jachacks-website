---
import '../styles/site.css';
import '../styles/hacker-guide.css';
---

<html lang="en">
  <head>
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t === 'light') document.documentElement.setAttribute('data-theme','light'); } catch(e){}
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/jaseci-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JacHacks A2Tech · Hacker Guide</title>
    <meta name="description" content="The JacHacks A2Tech hacker guide: schedule, location, tracks, rules, submissions, and everything you need for September 26–27, 2026 at the University of Michigan, Ann Arbor." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://jachacks.org/a2tech-guide" />
    <meta property="og:title" content="JacHacks A2Tech · Hacker Guide" />
    <meta property="og:description" content="Everything you need for JacHacks A2Tech in one place: schedule, tracks, rules, and submissions. September 26–27, 2026, Ann Arbor, MI." />
    <meta property="og:image" content="https://jachacks.org/jaseci-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700;1,800&family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <!-- NAV -->
    <nav id="main-nav">
      <div class="nav-inner">
        <a href="/" class="logo">
          <img src="/jaseci-logo.png" alt="JacHacks" class="logo-img" />
          <span class="logo-text">Jac<span class="logo-accent">Hacks</span></span>
        </a>
        <div class="nav-links">
          <a href="/a2tech" class="nav-link">// A2TECH</a>
          <a href="#schedule" class="nav-link">// SCHEDULE</a>
          <a href="#tracks" class="nav-link">// TRACKS</a>
          <a href="#local-impact" class="nav-link">// LOCAL IMPACT</a>
          <a href="#submissions" class="nav-link">// SUBMIT</a>
          <a href="#rules" class="nav-link">// RULES</a>
          <a href="#resources" class="nav-link">// RESOURCES</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
          <svg class="tt-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="tt-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href="https://luma.com/jlpxupsw" target="_blank" rel="noopener noreferrer" class="nav-cta">REGISTER NOW</a>
        <button class="hamburger" id="hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href="/">// HOME</a>
      <a href="/a2tech">// JACHACKS A2TECH</a>
      <a href="#schedule">// SCHEDULE</a>
      <a href="#tracks">// TRACKS</a>
      <a href="#local-impact">// LOCAL IMPACT</a>
      <a href="#submissions">// SUBMIT</a>
      <a href="#rules">// RULES</a>
      <a href="#resources">// RESOURCES</a>
      <a href="https://luma.com/jlpxupsw" target="_blank" class="mobile-cta">REGISTER NOW</a>
    </div>

    <!-- GUIDE HERO -->
    <section class="sfg-hero a2g-hero">
      <div class="hero-grid-bg"></div>
      <div class="hero-spotlight"></div>
      <img class="a2g-hero-lines" src="/a2-lines.png" alt="" aria-hidden="true" />
      <div class="sfg-hero-content">
        <div class="a2g-lockup reveal">
          <span class="a2g-lockup-label">OFFICIAL HACKATHON PARTNER OF</span>
          <a href="https://a2tech360.com" target="_blank" rel="noopener noreferrer" class="a2g-lockup-link" aria-label="a2Tech360, powered by Ann Arbor SPARK">
            <img src="/a2tech360-logo-white.webp" alt="a2Tech360, powered by Ann Arbor SPARK" class="a2g-lockup-logo a2g-logo-dark" />
            <img src="/a2tech360-logo-color.webp" alt="" aria-hidden="true" class="a2g-lockup-logo a2g-logo-light" />
          </a>
        </div>
        <div class="hero-series-badge reveal">
          <span class="series-dot"></span>
          <span>JACHACKS A2TECH 2026</span>
          <span class="series-sep">·</span>
          <span class="series-event">HACKER GUIDE</span>
        </div>
        <h1 class="title-main reveal">Hacker <span class="title-spring">Guide.</span></h1>
        <p class="hero-sub reveal">Everything you need for the weekend in one place. A two-day AI hackathon hosted by Jaseci Labs. Questions? Drop them in <b>#ask-an-organizer</b> on Discord.</p>
        <div class="hero-meta-line reveal">
          <span>SAT–SUN, SEP 26–27</span>
          <span class="meta-dot">·</span>
          <span>LEINWEBER BUILDING</span>
          <span class="meta-dot">·</span>
          <span>U-M NORTH CAMPUS, ANN ARBOR</span>
        </div>
        <div class="cta-group reveal">
          <a href="#schedule" class="btn-primary">
            VIEW SCHEDULE
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
          <a href="https://discord.gg/Av2JKhVyA" target="_blank" rel="noopener noreferrer" class="btn-accent">
            JOIN DISCORD
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
          <a href="https://jachacks-a2tech.devpost.com/" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            DEVPOST
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- QUICK INFO CARDS -->
    <section class="section sfg-section-tight">
      <div class="container">
        <div class="sfg-info-grid reveal">
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="sfg-info-label">LOCATION</div>
            <div class="sfg-info-title">Leinweber Building</div>
            <p class="sfg-info-desc">Leinweber Computer Science and Information Building, 2200 Hayward Street, Ann Arbor, MI 48109. Check-in, hacking, meals, workshops, judging, and closing all happen on-site.</p>
          </div>
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1"/></svg>
            </div>
            <div class="sfg-info-label">WIFI</div>
            <div class="sfg-info-title">eduroam or MGuest</div>
            <p class="sfg-info-desc">Log into <b>eduroam</b> with your college credentials (email and password). No eduroam? Connect to <b>MGuest</b>.</p>
          </div>
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <div class="sfg-info-label">DISCORD</div>
            <div class="sfg-info-title">Main comms channel</div>
            <p class="sfg-info-desc">Announcements, schedule updates, mentor requests, and team matching. Post questions in <b>#ask-an-organizer</b>. <a class="sfg-link" href="https://discord.gg/Av2JKhVyA" target="_blank" rel="noopener noreferrer">Join before the event →</a></p>
          </div>
          <div class="sfg-info-card">
            <div class="sfg-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
            </div>
            <div class="sfg-info-label">FOOD</div>
            <div class="sfg-info-title">You're covered</div>
            <p class="sfg-info-desc">Breakfast, lunch, dinner, and snacks all weekend. Dietary restrictions? Flag them on your Luma registration or ping us on Discord.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section class="section" id="schedule">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-eyebrow">// THE SCHEDULE</div>
          <h2 class="section-title">Two Days. <span class="text-accent">One Long Night.</span></h2>
          <p class="section-sub">Here's exactly how the weekend runs. Any day-of updates will be posted on Discord.</p>
        </div>

        <div class="a2g-days reveal">
          <div>
            <div class="a2g-day"><span class="a2g-day-num">DAY 1</span><span class="a2g-day-date">SATURDAY, SEP 26</span><span class="a2g-day-rule"></span></div>
            <div class="sfg-timeline">
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">9:00 – 10:00 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Check-In + Networking</div>
                  <div class="sfg-tl-desc">Grab your badge, meet other builders, and get settled</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">10:00 – 11:00 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Opening + Keynote</div>
                  <div class="sfg-tl-desc">Welcome to JacHacks A2Tech, followed by a keynote from Prof. Jason Mars</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">11:00 – 11:30 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Hackathon Briefing</div>
                  <div class="sfg-tl-desc">Rules, tracks, prizes, sponsor resources, judging criteria, and how to submit</div>
                </div>
              </div>
              <div class="sfg-tl-item sfg-tl-featured">
                <div class="sfg-tl-time">11:30 AM – 12:30 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Jac Workshop <span class="sfg-tl-tag">DON'T SKIP THIS</span></div>
                  <div class="sfg-tl-desc">Led by Jayanaka and Nitin. Zero to shipping on Jac, all levels welcome.</div>
                </div>
              </div>
              <div class="sfg-tl-item sfg-tl-milestone sfg-tl-green">
                <div class="sfg-tl-time">12:30 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">⭐ Hacking Begins</div>
                  <div class="sfg-tl-desc">Clocks start. Build. Collaborate. Iterate.</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">1:00 – 2:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Lunch + Networking</div>
                  <div class="sfg-tl-desc">Lunch is served. Keep planning while you eat.</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">3:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">IBM / Sponsor Workshop</div>
                  <div class="sfg-tl-desc">Hands-on session from our sponsors</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">3:00 – 5:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">First Build Block</div>
                  <div class="sfg-tl-desc">Finalize teams, lock in ideas, and start building</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">5:00 – 5:30 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Mentor Check-In</div>
                  <div class="sfg-tl-desc">Mentors circulate for questions, feedback, and technical support</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">5:30 – 7:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Second Build Block</div>
                  <div class="sfg-tl-desc">Mentor office hours and sponsor support continue</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">6:30 – 7:30 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Dinner + Networking</div>
                  <div class="sfg-tl-desc">Dinner is served alongside continued project work</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">8:00 PM – 12:00 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Third Build Block + Snacks</div>
                  <div class="sfg-tl-desc">Keep building, testing, and preparing your demo</div>
                </div>
              </div>
              <div class="sfg-tl-item sfg-tl-milestone sfg-tl-purple">
                <div class="sfg-tl-time">12:00 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">🌙 Overnight Build Continues</div>
                  <div class="sfg-tl-desc">Keep building overnight. Final submissions are due the next day at 12:00 PM.</div>
                </div>
              </div>
            </div>
          </div>

          <div>
            <div class="a2g-day"><span class="a2g-day-num">DAY 2</span><span class="a2g-day-date">SUNDAY, SEP 27</span><span class="a2g-day-rule"></span></div>
            <div class="sfg-timeline">
              <div class="sfg-tl-item sfg-tl-milestone sfg-tl-orange">
                <div class="sfg-tl-time">9:30 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">⭐ Partial Submission Checkpoint</div>
                  <div class="sfg-tl-desc">Submit your draft on Devpost to be considered for judging. You can continue editing afterward.</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">10:00 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Brunch + Final Mentor Office Hours</div>
                  <div class="sfg-tl-desc">Refuel, get last-minute feedback, and make final improvements</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">10:30 – 11:30 AM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Final Build + Demo Preparation</div>
                  <div class="sfg-tl-desc">Finish your project, test the demo, and prepare your presentation</div>
                </div>
              </div>
              <div class="sfg-tl-item sfg-tl-milestone sfg-tl-red">
                <div class="sfg-tl-time">12:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">🛑 Final Submissions Due <span class="sfg-tl-tag sfg-tag-red">HARD DEADLINE</span></div>
                  <div class="sfg-tl-desc">Submit your project before noon. Late submissions are not accepted.</div>
                </div>
              </div>
              <div class="sfg-tl-item">
                <div class="sfg-tl-time">12:30 – 2:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Judging</div>
                  <div class="sfg-tl-desc">Teams present their projects to judges in short demo sessions</div>
                </div>
              </div>
              <div class="sfg-tl-item sfg-tl-milestone sfg-tl-cyan">
                <div class="sfg-tl-time">2:00 – 3:00 PM</div>
                <div class="sfg-tl-rail"><span class="sfg-tl-dot"></span></div>
                <div class="sfg-tl-body">
                  <div class="sfg-tl-name">Closing Ceremony</div>
                  <div class="sfg-tl-desc">Winner announcements, prizes, and sponsor and judge recognition</div>
                </div>
              </div>
            </div>

            <!-- DEADLINE CALLOUT -->
            <div class="sfg-deadlines a2g-deadlines">
              <div class="sfg-deadline-card sfg-dl-orange">
                <div class="sfg-dl-time">SUN 9:30 AM</div>
                <div class="sfg-dl-label">PARTIAL SUBMISSION CHECKPOINT</div>
                <p>Make your first partial submission on Devpost to be considered for judging. You can still edit after.</p>
              </div>
              <div class="sfg-deadline-card sfg-dl-red">
                <div class="sfg-dl-time">SUN 12:00 PM</div>
                <div class="sfg-dl-label">FINAL SUBMISSIONS · HARD DEADLINE</div>
                <p>No late submissions will be accepted. Submit early, edit often.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRACKS & AWARDS -->
    <section class="section" id="tracks">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-eyebrow">// TRACKS & AWARDS</div>
          <h2 class="section-title">Pick Your <span class="text-accent">Tracks.</span></h2>
          <p class="section-sub">All projects are eligible for every track. When you submit on Devpost, select the tracks you'd like to be considered for. Pick the ones that meaningfully fit your project.</p>
        </div>

        <div class="sfg-prize-tier reveal">MAIN TRACKS <span class="sfg-tier-hint">· select every track that fits</span></div>
        <div class="sfg-prize-grid sfg-prize-grid-3 reveal">
          <div class="sfg-prize-card sfg-prize-featured">
            <div class="sfg-prize-track">AGENTIC AI</div>
            <span class="a2g-award-tag">1ST + 2ND PLACE</span>
            <p class="sfg-prize-note">Best agentic AI project built at JacHacks A2Tech</p>
          </div>
          <div class="sfg-prize-card">
            <div class="sfg-prize-track">DEV TOOLS &amp; INFRA</div>
            <span class="a2g-award-tag">1ST + 2ND PLACE</span>
            <p class="sfg-prize-note">Best developer tools, infrastructure, or tooling project</p>
          </div>
          <a href="#local-impact" class="sfg-prize-card a2g-prize-local">
            <div class="sfg-prize-track">LOCAL IMPACT</div>
            <span class="a2g-award-tag">GRAND PRIZE + COMMUNITY FAVORITE</span>
            <p class="sfg-prize-note">Best combines local relevance, technical execution, and a plausible path to existing after the weekend. <span class="sfg-link">See the track →</span></p>
          </a>
        </div>

        <div class="sfg-prize-tier reveal">JAC AWARDS <span class="sfg-tier-hint">· select separately</span></div>
        <div class="sfg-prize-grid sfg-prize-grid-3 reveal">
          <div class="sfg-prize-card sfg-prize-special">
            <div class="sfg-prize-track">BEST JACHAMMER</div>
            <span class="a2g-award-tag">SPECIAL AWARD</span>
            <p class="sfg-prize-note">Use <a class="sfg-link" href="https://jachammer.ai" target="_blank" rel="noopener noreferrer">jachammer.ai</a> to build and ship a working application.</p>
          </div>
          <div class="sfg-prize-card sfg-prize-special">
            <div class="sfg-prize-track">BEST JACLANG</div>
            <span class="a2g-award-tag">SPECIAL AWARD</span>
            <p class="sfg-prize-note">The team that hammers hardest on Jac, the most impressive use of the Jac language</p>
          </div>
          <div class="sfg-prize-card sfg-prize-special">
            <div class="sfg-prize-track">BEST MOBILE THROUGH JAC</div>
            <span class="a2g-award-tag">SPECIAL AWARD</span>
            <p class="sfg-prize-note">Strong mobile project built with Jac or Jac-compatible mobile tooling</p>
          </div>
        </div>

        <div class="sfg-prize-tier reveal">SPONSOR AWARDS <span class="sfg-tier-hint">· select separately</span></div>
        <div class="sfg-prize-grid reveal">
          <div class="sfg-prize-card a2g-prize-sponsor">
            <div class="sfg-prize-track">BEST OF GOOGLE</div>
