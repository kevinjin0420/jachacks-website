---
import '../styles/site.css';

// Builder testimonials from the JacHacks post-event surveys.
//   cat 'event' -> the hackathon itself   ·   cat 'build' -> building with the Jac stack
//   highlight   -> exact substring of the quote, marker-highlighted so the wall stays scannable
// Ordered so the same person never lands twice in the same row of the grid.
const testimonials = [
  {
    cat: 'event',
    quote: "JacHacks x Founders Inc brought the most ambitious minds in tech and put them under one roof. The event was ran extremely well and the hosts were very organized. If you want to code a basic project, this hackathon isn't for you. But if you're willing to push yourself, grow, and set your mind to shipping something in one afternoon, this comp is perfect for you.",
    highlight: 'the most ambitious minds in tech',
    name: 'Jacob Aral Quion',
    exp: '3–5 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'The graph-based part and the walkers allowed us to come up with a really unique solution for finding multi drug synergies which I found interesting.',
    highlight: 'a really unique solution for finding multi drug synergies',
    name: 'Zorawar Brar',
    exp: '3–5 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'event',
    quote: 'Building with the Jac stack and engaging with the community made JacHacks SF an incredible, hands-on experience!',
    highlight: 'an incredible, hands-on experience',
    name: 'Rafael Lopez',
    exp: '10+ yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'I particularly liked the unified full-stack experience, graph-based programming model, and the byLLM keyword for native AI integration. Together, they reduced boilerplate, accelerated development, and made it easier to focus on building intelligent applications rather than managing multiple tools and frameworks.',
    highlight: 'the byLLM keyword for native AI integration',
    name: 'Sarath Kothapalli',
    exp: '1–2 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'event',
    quote: 'Had a great experience overall. The hackathon was fun, collaborative, and a great opportunity to explore new technologies while building something meaningful.',
    highlight: 'fun, collaborative',
    name: 'Kamrul Hassan',
    exp: '1–2 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'It was really seamless, the agent understood the language and architecture much easily and wrote better more streamlined code overall.',
    highlight: 'It was really seamless',
    name: 'Aditya Das',
    exp: '5–10 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'I just like the different approach of byLLM instead of prompt engineering. It also meant having a more clean and understandable codebase which is a huge plus.',
    highlight: 'byLLM instead of prompt engineering',
    name: 'Yousef Al-Wahami',
    exp: '3–5 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'event',
    quote: 'Great experience with my first large hackathon and had a great opportunity networking with recruiters and founders.',
    highlight: 'networking with recruiters and founders',
    name: 'Rohit Vaishali Motdhare',
    exp: '3–5 yrs building software',
    tags: [{ label: 'First big hackathon', kind: 'star' }],
  },
  {
    cat: 'build',
    quote: "I liked how I could do everything in one language and didn't have to move between frameworks.",
    highlight: 'everything in one language',
    name: 'Vachan Bhogi',
    exp: '5–10 yrs building software',
    tags: [{ label: 'Python, JS/TS, Java, C/C++, Rust', kind: '' }],
  },
  {
    cat: 'event',
    quote: 'Wonderful time meeting all the different members of the Jac team and Jason as well. It was a fun and enriching experience.',
    highlight: 'a fun and enriching experience',
    name: 'Aditya Das',
    exp: '5–10 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'The unified programming paradigm and the graph-based model make structuring full-stack AI workflows cleaner and more intuitive.',
    highlight: 'cleaner and more intuitive',
    name: 'Rafael Lopez',
    exp: '10+ yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'Graph-based programming also felt very natural for this problem. Since the system is inherently graph-structured, modeling it directly as nodes and edges made the logic easier to reason about.',
    highlight: 'felt very natural for this problem',
    name: 'Yanshengtian Dong',
    exp: '1–2 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'event',
    quote: 'It was a refreshing learning opportunity, and I enjoyed experimenting with Jac and actually a new way of thinking about software and AI development!',
    highlight: 'a refreshing learning opportunity',
    name: 'Sarath Kothapalli',
    exp: '1–2 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'The one language end to end development was great because it made it really easy to build using the language and change ideas with the AI understanding everything it was doing from the start.',
    highlight: 'The one language end to end development',
    name: 'Aditya Das',
    exp: '5–10 yrs building software',
    tags: [{ label: 'Brand new to Jac', kind: 'new' }],
  },
  {
    cat: 'build',
    quote: 'I really like the graph based memory and AI native design. Smooth interaction with other tech stack. Clean agent building.',
    highlight: 'graph based memory and AI native design',
    name: 'Nitish Kumar Singh',
    exp: '3–5 yrs building software',
    tags: [
      { label: 'Built with Jac before', kind: '' },
      { label: '10/10 would keep using Jac', kind: 'star' },
    ],
  },
];

function initials(name: string) {
  const parts = name.trim().split(/\s+/);
  return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
}
