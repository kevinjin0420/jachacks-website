---
import '../styles/site.css';
---

<html lang="en">
  <head>
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t === 'light') document.documentElement.setAttribute('data-theme','light'); } catch(e){}
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/jaseci-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JacHacks · Hackathon Series</title>
    <meta name="description" content="JacHacks SF: a one-day, in-person hackathon for the Bay Area tech community. July 26, 2026, Founders, Inc., San Francisco." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://jachacks.org/" />
    <meta property="og:title" content="JacHacks SF · In-Person Hackathon" />
    <meta property="og:description" content="One day. In person. Build the future with Jac. July 26, 2026, Founders, Inc., San Francisco." />
    <meta property="og:image" content="https://jachacks.org/jaseci-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700;1,800&family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <!-- NAV -->
    <nav id="main-nav">
      <div class="nav-inner">
        <a href="/" class="logo">
          <img src="/jaseci-logo.png" alt="JacHacks" class="logo-img" />
          <span class="logo-text">Jac<span class="logo-accent">Hacks</span></span>
        </a>
        <div class="nav-links">
          <a href="#sf-winners" class="nav-link">// SF WINNERS</a>
          <a href="/spring" class="nav-link">// SPRING</a>
          <a href="/winter" class="nav-link">// WINTER</a>
          <a href="#popups" class="nav-link">// POPUPS</a>
          <a href="/gallery" class="nav-link">// GALLERY</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
          <svg class="tt-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="tt-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href="https://github.com/jaseci-labs/jaseci" target="_blank" rel="noopener noreferrer" class="nav-cta">STAR ON GITHUB</a>
        <button class="hamburger" id="hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href="#sf-winners">// JACHACKS SF WINNERS</a>
      <a href="/sf-guide" class="mobile-cta">// JACHACKS SF GUIDE</a>
      <a href="/spring">// JACHACKS SPRING</a>
      <a href="/winter">// JACHACKS WINTER</a>
      <a href="/paradise">// VELRIC</a>
      <a href="/ohio">// ROCKETHACKS</a>
      <a href="/gallery">// GALLERY</a>
      <a href="https://github.com/jaseci-labs/jaseci" target="_blank" class="mobile-cta">STAR ON GITHUB</a>
    </div>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid-bg"></div>
      <canvas id="bg-canvas"></canvas>

      <div class="hud-tl">
        <span class="hud-label">SYS://SAN_FRANCISCO</span>
      </div>
      <div class="hud-tr">
        <span class="hud-label hud-label-white">EVENT://JUL_26_2026</span>
      </div>
      <div class="hud-bl">
        <span class="hud-label">DURATION: <span class="hud-count">01DAY</span></span>
      </div>
      <div class="hud-br">
        <span class="hud-label hud-label-accent">REGION://BAY_AREA</span>
      </div>

      <div class="float-el fe-hex-1">
        <svg viewBox="0 0 60 69" width="60" height="69" fill="none">
          <polygon points="30,3 57,18 57,51 30,66 3,51 3,18" stroke="rgba(249,115,22,0.3)" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="float-el fe-hex-2">
        <svg viewBox="0 0 40 46" width="40" height="46" fill="none">
          <polygon points="20,2 38,12 38,34 20,44 2,34 2,12" stroke="rgba(0,212,255,0.25)" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="float-el fe-hex-3">
        <svg viewBox="0 0 90 104" width="90" height="104" fill="none">
          <polygon points="45,4 86,27 86,77 45,100 4,77 4,27" stroke="rgba(249,115,22,0.1)" stroke-width="1"/>
        </svg>
      </div>
      <div class="float-el fe-plus-1">+</div>
      <div class="float-el fe-plus-2">+</div>
      <div class="float-el fe-plus-3">×</div>
      <div class="float-el fe-ring-1"></div>
      <div class="float-el fe-ring-2"></div>
      <div class="float-el fe-ring-3"></div>

      <div class="hero-spotlight"></div>

      <!-- Golden Gate Bridge wireframe backdrop -->
      <img class="hero-bridge" src="/ggb-wireframe.svg" alt="" aria-hidden="true" />
      <div class="hero-scrim"></div>

      <div class="hero-content">
        <div class="hero-series-badge">
          <span class="series-dot"></span>
          <span>JACHACKS SERIES</span>
          <span class="series-sep">·</span>
          <span class="series-event">SAN FRANCISCO</span>
        </div>

        <div class="hero-title">
          <a href="https://jaclang.org/" target="_blank" rel="noopener noreferrer" aria-label="Jaseci"><img src="/jaseci-logo.png" alt="" class="hero-j-logo" /></a>
          <h1 class="title-main">JacHacks <span class="title-spring">SF</span></h1>
        </div>

        <p class="hero-sub">The series lands in the Bay Area. A one-day, in-person hackathon for San Francisco's builders and tech community.</p>

        <div class="hero-meta-line">
          <span>JULY 26, 2026</span>
          <span class="meta-dot">·</span>
          <span>8:00 AM PT</span>
          <span class="meta-dot">·</span>
          <span>FOUNDERS, INC. · SAN FRANCISCO</span>
        </div>

        <div class="wrap-panel" id="wrap-panel">
          <span class="wrap-sheen"></span>
          <div class="wrap-eyebrow">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            THAT'S A WRAP
            <span class="wrap-eyebrow-sep">·</span>
            <span class="wrap-eyebrow-alt">JULY 26, 2026</span>
          </div>

          <div class="wrap-stats">
            <div class="wrap-stat">
              <span class="wrap-num" data-count="200" data-suffix="+">200+</span>
              <span class="wrap-stat-label">BUILDERS</span>
            </div>
            <span class="wrap-divider"></span>
            <div class="wrap-stat">
              <span class="wrap-num" data-count="77">77</span>
              <span class="wrap-stat-label">PROJECTS SHIPPED</span>
            </div>
            <span class="wrap-divider"></span>
            <div class="wrap-stat">
              <span class="wrap-num" data-count="8">8</span>
              <span class="wrap-stat-label">WINNERS</span>
            </div>
          </div>
        </div>

        <div class="cta-group">
          <a href="#sf-winners" class="btn-primary btn-register">
            <span class="cs-dot"></span>
            SEE THE WINNERS
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="https://jachacks-sf.devpost.com/project-gallery" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            VIEW ALL PROJECTS
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </a>
          <a href="#editions" class="btn-ghost">
            EXPLORE PAST JACHACKS
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
        </div>
      </div>

      <div class="scroll-down">
        <span>SCROLL</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </div>
    </section>

    <!-- PLATINUM SPONSOR -->
    <div class="platinum-sponsor reveal">
      <span class="platinum-label">POWERED BY</span>
      <a href="https://jaclang.org/" target="_blank" rel="noopener noreferrer" class="platinum-link">
        <img src="/sponsors/jaseci_with_name_transparent.png" alt="Jaseci" class="platinum-logo platinum-logo-dark" />
        <img src="/sponsors/jaseci_with_name_transparent_light.png" alt="Jaseci" class="platinum-logo platinum-logo-light" />
      </a>
      <p class="platinum-desc">Powering the future of AI programming</p>
    </div>

    <!-- SPONSOR STRIP -->
    <div class="sponsor-strip">
      <span class="strip-label">SPONSORS AND PARTNERS</span>
      <div class="strip-marquee">
        <div class="strip-track">
          <a class="strip-logo" href="https://www.nvidia.com" target="_blank" rel="noopener noreferrer"><img src="/sponsors/nvidia_inception.png" alt="NVIDIA Inception Program" /></a>
          <a class="strip-logo" href="https://mastra.ai" target="_blank" rel="noopener noreferrer"><img src="/sponsors/mastra.png" alt="Mastra" /></a>
          <a class="strip-logo" href="https://umich.edu" target="_blank" rel="noopener noreferrer"><img src="/sponsors/UofM.png" alt="University of Michigan" /></a>
          <a class="strip-logo" href="https://www.nsf.gov" target="_blank" rel="noopener noreferrer"><img src="/sponsors/NSF_logo.svg.webp" alt="NSF" /></a>
          <a class="strip-logo" href="https://base44.com" target="_blank" rel="noopener noreferrer"><img src="/sponsors/base44.png" alt="Base44" /></a>
          <a class="strip-logo" href="https://koyal.ai" target="_blank" rel="noopener noreferrer"><img src="/sponsors/koyal_ai_logo.png" alt="Koyal AI" /></a>
          <a class="strip-logo" href="https://pieces.app" target="_blank" rel="noopener noreferrer"><img src="/sponsors/pieces.png" alt="Pieces" /></a>
          <a class="strip-logo" href="https://www.nvidia.com" target="_blank" rel="noopener noreferrer"><img src="/sponsors/nvidia_inception.png" alt="NVIDIA Inception Program" /></a>
          <a class="strip-logo" href="https://mastra.ai" target="_blank" rel="noopener noreferrer"><img src="/sponsors/mastra.png" alt="Mastra" /></a>
          <a class="strip-logo" href="https://umich.edu" target="_blank" rel="noopener noreferrer"><img src="/sponsors/UofM.png" alt="University of Michigan" /></a>
          <a class="strip-logo" href="https://www.nsf.gov" target="_blank" rel="noopener noreferrer"><img src="/sponsors/NSF_logo.svg.webp" alt="NSF" /></a>
          <a class="strip-logo" href="https://base44.com" target="_blank" rel="noopener noreferrer"><img src="/sponsors/base44.png" alt="Base44" /></a>
          <a class="strip-logo" href="https://koyal.ai" target="_blank" rel="noopener noreferrer"><img src="/sponsors/koyal_ai_logo.png" alt="Koyal AI" /></a>
          <a class="strip-logo" href="https://pieces.app" target="_blank" rel="noopener noreferrer"><img src="/sponsors/pieces.png" alt="Pieces" /></a>
          <a class="strip-logo" href="https://www.nvidia.com" target="_blank" rel="noopener noreferrer"><img src="/sponsors/nvidia_inception.png" alt="NVIDIA Inception Program" /></a>
          <a class="strip-logo" href="https://mastra.ai" target="_blank" rel="noopener noreferrer"><img src="/sponsors/mastra.png" alt="Mastra" /></a>
          <a class="strip-logo" href="https://umich.edu" target="_blank" rel="noopener noreferrer"><img src="/sponsors/UofM.png" alt="University of Michigan" /></a>
          <a class="strip-logo" href="https://www.nsf.gov" target="_blank" rel="noopener noreferrer"><img src="/sponsors/NSF_logo.svg.webp" alt="NSF" /></a>
          <a class="strip-logo" href="https://base44.com" target="_blank" rel="noopener noreferrer"><img src="/sponsors/base44.png" alt="Base44" /></a>
          <a class="strip-logo" href="https://koyal.ai" target="_blank" rel="noopener noreferrer"><img src="/sponsors/koyal_ai_logo.png" alt="Koyal AI" /></a>
          <a class="strip-logo" href="https://pieces.app" target="_blank" rel="noopener noreferrer"><img src="/sponsors/pieces.png" alt="Pieces" /></a>
        </div>
      </div>
    </div>

    <!-- JACHACKS SF WINNERS -->
    <section class="section section-dark" id="sf-winners">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-eyebrow">// JACHACKS SF · WINNERS</div>
          <h2 class="section-title">The Best of <span class="text-accent">JacHacks SF</span></h2>
          <p class="section-sub">The standout projects, built in one day, in person at Founders, Inc., July 2026.</p>
        </div>

        <!-- Agentic AI -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Agentic AI</span>
            <span class="track-label-sub">2 WINNERS</span>
          </div>
          <div class="projects-grid projects-grid-2">
            <div class="pcard reveal"
              data-video="mCW-2MeBIL0"
              data-devpost="https://devpost.com/software/traction-6se7mr">
              <div class="pcard-bar bar-1st"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_photos/005/027/838/datas/original.png" alt="TRACTION" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-1st">1ST PLACE</span></div>
                <h3 class="pcard-title">TRACTION</h3>
                <p class="pcard-team">Elijah Umana, Becky Zhu</p>
                <p class="pcard-desc">Five research lanes run in parallel to find the people already complaining about your problem, verify them across LinkedIn and GitHub, then email, call, and book the interviews.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/traction-6se7mr" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-1"
              data-video="Ws2XPfxSQ6o"
              data-devpost="https://devpost.com/software/trails-f0w8oc">
              <div class="pcard-bar bar-2nd"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_thumbnail_photos/005/027/492/datas/original.png" alt="Trails" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-2nd">2ND PLACE</span></div>
                <h3 class="pcard-title">Trails</h3>
                <p class="pcard-team">Harshith Sai Mannaru, Tirth Suba, Aarnav Gutti</p>
                <p class="pcard-desc">Five agents walk a graph of your evidence like ants, marking connections as they go, and hand research teams the reasoning chains behind a theory instead of a confident paragraph.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/trails-f0w8oc" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Fintech -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Fintech / Open</span>
            <span class="track-label-sub">2 WINNERS</span>
          </div>
          <div class="projects-grid projects-grid-2">
            <div class="pcard reveal"
              data-video="qy637iMeR_s"
              data-devpost="https://devpost.com/software/reminisense">
              <div class="pcard-bar bar-1st"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_photos/005/027/710/datas/original.png" alt="Recall" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-1st">1ST PLACE</span></div>
                <h3 class="pcard-title">Recall</h3>
                <p class="pcard-team">Aswath Jacob, Arshmeet Sodhi, Umang Sharma, Likhith Ramesha</p>
                <p class="pcard-desc">A networking memory that runs on your glasses, captioning the conversation and building a Jac graph of who you met, what they are raising, and what you owe them, recalled with one gesture.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/reminisense" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-1"
              data-video=""
              data-loom="adaeb88d9db24624a4bf9415d3d08dd5"
              data-devpost="https://devpost.com/software/lemons-o42wrb">
              <div class="pcard-bar bar-2nd"></div>
              <div class="pcard-thumb">
                <img src="https://cdn.loom.com/sessions/thumbnails/adaeb88d9db24624a4bf9415d3d08dd5-1e5088ecddc59959.jpg" alt="Lemons" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-2nd">2ND PLACE</span></div>
                <h3 class="pcard-title">Lemons</h3>
                <p class="pcard-team">Manit Guliani</p>
                <p class="pcard-desc">Ask it about any Kalshi or Polymarket outcome and it runs roughly 3,500 simulations over news, historical stats, and public sentiment to hand back a research backed prediction in under 20 seconds.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/lemons-o42wrb" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Impact -->
        <div class="track-section">
          <div class="track-header">
            <span class="track-header-icon">//</span>
            <span class="track-label">Social Impact</span>
            <span class="track-label-sub">2 WINNERS</span>
          </div>
          <div class="projects-grid projects-grid-2">
            <div class="pcard reveal"
              data-video="KScFBI7-xpI"
              data-devpost="https://devpost.com/software/saferelay">
              <div class="pcard-bar bar-1st"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_thumbnail_photos/005/027/861/datas/original.jpg" alt="SafeRelay" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-1st">1ST PLACE</span></div>
                <h3 class="pcard-title">SafeRelay</h3>
                <p class="pcard-team">Rishabh Bansal, Aditya Das</p>
                <p class="pcard-desc">When the cell towers are gone, SafeRelay hops 25 byte emergency reports from phone to phone over Bluetooth and pushes them to responders the moment any device regains a signal.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/saferelay" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
            </div>

            <div class="pcard reveal delay-1"
              data-video="pwDT-jaVTDM"
              data-devpost="https://devpost.com/software/brailed">
              <div class="pcard-bar bar-2nd"></div>
              <div class="pcard-thumb">
                <img src="https://d112y698adiu2z.cloudfront.net/photos/production/software_photos/005/027/665/datas/original.png" alt="Brailed" />
                <div class="pcard-rec">DEMO</div>
                <div class="pcard-play-overlay">
                  <div class="play-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg></div>
                  <span class="play-label">CLICK TO WATCH</span>
                </div>
              </div>
              <div class="pcard-body">
                <div class="pcard-badges"><span class="pbadge pbadge-2nd">2ND PLACE</span></div>
                <h3 class="pcard-title">Brailed</h3>
                <p class="pcard-team">Kaushik Chekka, Dhruv Gupta, Yash Kathrani</p>
                <p class="pcard-desc">A phone mounted device for blind and deaf users, built from about $10 in parts: type braille on a six key chord, read live captions on an OLED, and drive the phone with natural language.</p>
              </div>
              <div class="pcard-actions">
                <a class="pcard-devpost" href="https://devpost.com/software/brailed" target="_blank" rel="noopener noreferrer">DEVPOST →</a>
              </div>
